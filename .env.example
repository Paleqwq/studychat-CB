# Build-time browser configuration: China-site CloudBase PostgreSQL environment.
NEXT_PUBLIC_DATA_BACKEND=cloudbase
NEXT_PUBLIC_CLOUDBASE_ENV_ID=
NEXT_PUBLIC_CLOUDBASE_REGION=ap-shanghai
# Public/publishable key ONLY. Never put a service-role API key here.
NEXT_PUBLIC_CLOUDBASE_PUBLISHABLE_KEY=
# Runtime server ONLY: CloudBase API key with service_role privileges.
CLOUDBASE_API_KEY=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this key safe. Changing it prevents decrypting previously saved API keys.
CONFIG_ENCRYPTION_KEY=
# Runtime server ONLY. Exact public HTTPS origin, without a trailing slash.
# Required behind CloudBase's HTTPS reverse proxy; leave empty for local dev.
APP_ORIGIN=
# Exact trusted hostnames, comma-separated. Add your gateway before configuring it.
AI_ALLOWED_HOSTS=api.openai.com,api.anthropic.com,api.deepseek.com,openrouter.ai,api.siliconflow.cn
# Optional shared study access code; not an identity or recovery credential.
STUDY_ACCESS_CODE=
# Optional independent English assistant access code. Bloom's code does not apply here.
ENGLISH_ASSISTANT_ACCESS_CODE=
# Optional legacy backend. Set NEXT_PUBLIC_DATA_BACKEND=supabase to use these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy Supabase only: enable Turnstile with its secret in Supabase Auth.
# CloudBase uses its own Auth settings; this integration does not send Turnstile tokens.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Local development only; ignored in production and on Vercel.
DEMO_MODE=false
